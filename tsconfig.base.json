{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "harvis-standards v2. Extender desde el repo: { \"extends\": \"@bryan56gm/harvis-standards/tsconfig.base.json\", \"compilerOptions\": { \"paths\": { \"@/*\": [\"./*\"] } } }. Next añade plugins/jsx; Vite añade lib/types.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".astro", "coverage"]
}
